# Anthropic API key — used server-side only, for AI parsing of workout/run/meal entries.
ANTHROPIC_API_KEY=

# Supabase project URL and service role key — used server-side only (API routes).
# Find these in Supabase: Project Settings -> API.
# IMPORTANT: SUPABASE_SERVICE_ROLE_KEY bypasses row-level security. Never expose it
# to the browser or prefix it with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
